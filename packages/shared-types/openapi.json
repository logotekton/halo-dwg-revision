{
  "components": {
    "schemas": {
      "ConvertedAck": {
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "boolean"
          },
          "file_id": {
            "title": "File Id",
            "type": "string"
          }
        },
        "required": [
          "accepted",
          "file_id"
        ],
        "title": "ConvertedAck",
        "type": "object"
      },
      "ConvertedRequest": {
        "additionalProperties": false,
        "description": "``POST /files/{id}/converted`` body -- the desktop's DWG->DXF conversion result.",
        "properties": {
          "converter": {
            "enum": [
              "mlightcad-dxfout",
              "acad-ts"
            ],
            "title": "Converter",
            "type": "string"
          },
          "dxf_path": {
            "description": "Absolute path to the converted DXF, written by the desktop.",
            "title": "Dxf Path",
            "type": "string"
          },
          "entity_count": {
            "description": "Converter-reported entity count (crosscheck gate).",
            "minimum": 0.0,
            "title": "Entity Count",
            "type": "integer"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "dxf_path",
          "entity_count",
          "converter"
        ],
        "title": "ConvertedRequest",
        "type": "object"
      },
      "CrosscheckPersistRequest": {
        "additionalProperties": false,
        "description": "``POST /files/{id}/crosscheck`` body: the viewer's own ``LayerStatsDocument``.",
        "properties": {
          "other": {
            "additionalProperties": true,
            "description": "LayerStatsDocument computed client-side by CadHost's statsByLayer().",
            "title": "Other",
            "type": "object"
          },
          "whitelist": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whitelist YAML path. Omit for the shipped default; pass \"\" for none.",
            "title": "Whitelist"
          }
        },
        "required": [
          "other"
        ],
        "title": "CrosscheckPersistRequest",
        "type": "object"
      },
      "CrosscheckReport": {
        "additionalProperties": false,
        "description": "Full comparison of two ``LayerStatsDocument``s.\n\nStored as-is on ``drawing_file.parser_crosscheck``.",
        "properties": {
          "amber_layers": {
            "description": "Sorted layer names whose worst difference is AMBER.",
            "items": {
              "type": "string"
            },
            "title": "Amber Layers",
            "type": "array"
          },
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Layer counts by status: keys `GREEN`, `AMBER`, `RED`.",
            "title": "Counts",
            "type": "object"
          },
          "file_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "sha256 the two documents agree on, or null when they disagree.",
            "title": "File Sha256"
          },
          "file_sha256_mismatch": {
            "default": false,
            "description": "True when the two documents were computed from different bytes (DWG vs. its DXF conversion). Never fatal on its own — the comparison still runs (brief W2-04, Defaults for ambiguity).",
            "title": "File Sha256 Mismatch",
            "type": "boolean"
          },
          "layers": {
            "description": "One entry per bucket, ordered by (layer, space).",
            "items": {
              "$ref": "#/components/schemas/LayerResult"
            },
            "title": "Layers",
            "type": "array"
          },
          "other": {
            "$ref": "#/components/schemas/ProducerInfo"
          },
          "red_layers": {
            "description": "Sorted, deduplicated layer names carrying at least one RED difference. Confidence routing input (ADR-0002 6: 적색 레이어에 근거를 둔 항목은 신뢰도를 감점한다).",
            "items": {
              "type": "string"
            },
            "title": "Red Layers",
            "type": "array"
          },
          "reference": {
            "$ref": "#/components/schemas/ProducerInfo"
          },
          "schema_version": {
            "description": "Version of this report shape, not of the inputs.",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Severity",
            "description": "Worst status across every layer and the totals row."
          },
          "totals": {
            "$ref": "#/components/schemas/LayerResult",
            "description": "The same comparison applied to `totals`."
          },
          "warnings": {
            "description": "Non-fatal notes, e.g. the sha256 mismatch.",
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          },
          "whitelist_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whitelist file used, if any (as given on the command line).",
            "title": "Whitelist Path"
          }
        },
        "required": [
          "schema_version",
          "status",
          "reference",
          "other",
          "totals"
        ],
        "title": "CrosscheckReport",
        "type": "object"
      },
      "CrosscheckRequest": {
        "additionalProperties": false,
        "description": "Two inline ``LayerStatsDocument``s plus an optional whitelist path.\n\nThe documents are passed through as plain mappings rather than re-modelled\nhere: ``packages/schema`` owns the ``LayerStatsDocument`` shape, the\ncomparer only reads the seven contract measures, and an unknown extra key\nmust not turn a crosscheck into a 422.",
        "properties": {
          "other": {
            "additionalProperties": true,
            "description": "LayerStatsDocument compared against it.",
            "title": "Other",
            "type": "object"
          },
          "reference": {
            "additionalProperties": true,
            "description": "LayerStatsDocument taken as the reference.",
            "title": "Reference",
            "type": "object"
          },
          "whitelist": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Path to a known-parser-gap whitelist YAML. Omit for the shipped `halo_engine/validate/whitelist.yaml`; pass `\"\"` to compare with no whitelist.",
            "title": "Whitelist"
          }
        },
        "required": [
          "reference",
          "other"
        ],
        "title": "CrosscheckRequest",
        "type": "object"
      },
      "DiffField": {
        "description": "The compared measure a :class:`Difference` is about.\n\nOne member per row of ``docs/contracts/stats-definition.md`` \"비교 임계\",\nplus ``bucket`` for a ``(space, layer)`` bucket that exists on one side\nonly (always ``RED``: a missing bucket is never a tolerance question).",
        "enum": [
          "bucket",
          "count_by_type",
          "insert_by_block",
          "length_sum_mm",
          "hatch_area_sum_mm2",
          "text_count",
          "text_hash",
          "bbox"
        ],
        "title": "DiffField",
        "type": "string"
      },
      "Difference": {
        "additionalProperties": false,
        "description": "One measured disagreement inside one bucket.",
        "properties": {
          "absolute_delta": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Largest absolute corner delta in mm for `bbox`; null otherwise.",
            "title": "Absolute Delta"
          },
          "detail": {
            "description": "Human-readable cause, e.g. `count_by_type.LINE 24→22`. Rendered verbatim into the markdown report.",
            "title": "Detail",
            "type": "string"
          },
          "entity_types": {
            "description": "DXF record names present in this bucket (union of both sides, plus ATTRIB when the bucket's text_count exceeds its TEXT+MTEXT count). This is what a whitelist entry's `entity_type` matches against.",
            "items": {
              "type": "string"
            },
            "title": "Entity Types",
            "type": "array"
          },
          "field": {
            "$ref": "#/components/schemas/DiffField",
            "description": "Which measure disagrees."
          },
          "other_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The other document's value, as text.",
            "title": "Other Value"
          },
          "reference_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The reference document's value, as text.",
            "title": "Reference Value"
          },
          "relative_delta": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "|a-b| / max(|a|,|b|) for the numeric measures; null otherwise.",
            "title": "Relative Delta"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity",
            "description": "RED unless a whitelist entry explains it."
          },
          "whitelist_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Id of the whitelist entry that downgraded this difference (e.g. `W03`).",
            "title": "Whitelist Id"
          },
          "whitelist_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Reason quoted from the whitelist entry that downgraded this to AMBER.",
            "title": "Whitelist Reason"
          }
        },
        "required": [
          "field",
          "severity",
          "detail"
        ],
        "title": "Difference",
        "type": "object"
      },
      "DrawingFileSummary": {
        "additionalProperties": false,
        "description": "One row of ``GET /drawing-sets/{id}/files``.",
        "properties": {
          "codepage_effective": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
