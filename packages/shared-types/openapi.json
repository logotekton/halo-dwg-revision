      },
      "JobStatus": {
        "enum": [
          "QUEUED",
          "RUNNING",
          "DONE",
          "FAILED",
          "CANCELLED"
        ],
        "title": "JobStatus",
        "type": "string"
      },
      "JobSummary": {
        "additionalProperties": false,
        "description": "``GET /jobs/{id}`` response.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "drawing_set_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Drawing Set Id"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "progress": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Progress",
            "type": "number"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "progress",
          "created_at",
          "updated_at"
        ],
        "title": "JobSummary",
        "type": "object"
      },
      "LayerResult": {
        "additionalProperties": false,
        "description": "Verdict for one ``(space, layer)`` bucket.",
        "properties": {
          "differences": {
            "items": {
              "$ref": "#/components/schemas/Difference"
            },
            "title": "Differences",
            "type": "array"
          },
          "layer": {
            "description": "Layer name, or `(totals)` for the document totals row.",
            "title": "Layer",
            "type": "string"
          },
          "space": {
            "description": "`MODEL` or `PAPER:<layout>`, or `(all)` for the totals row.",
            "title": "Space",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Severity"
          }
        },
        "required": [
          "layer",
          "space",
          "status"
        ],
        "title": "LayerResult",
        "type": "object"
      },
      "ProducerInfo": {
