            "title": "Entity Count"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "format": {
            "$ref": "#/components/schemas/DrawingFormat"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "import_status": {
            "$ref": "#/components/schemas/ImportStatus"
          },
          "original_name": {
            "title": "Original Name",
            "type": "string"
          },
          "parser_crosscheck": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parser Crosscheck"
          },
          "working_dxf_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Working Dxf Path"
          }
        },
        "required": [
          "id",
          "original_name",
          "format",
          "import_status"
        ],
        "title": "DrawingFileSummary",
        "type": "object"
      },
      "DrawingFormat": {
        "enum": [
          "DWG",
          "DXF"
        ],
        "title": "DrawingFormat",
        "type": "string"
      },
      "DrawingSetCreateRequest": {
        "additionalProperties": false,
        "description": "``POST /projects/{id}/drawing-sets`` body.",
        "properties": {
          "converter_fallback": {
            "anyOf": [
              {
                "const": "acad-ts",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When set and no desktop is connected over WS for a DWG file, the engine runs the acad-ts CLI itself as a subprocess instead of waiting on `convert.request`/`converted` (brief W3-03: `--converter-fallback acad-ts`). Overrides the server's own `--converter-fallback` default for this import only.",
            "title": "Converter Fallback"
          },
          "files": {
            "description": "Absolute source paths to import. Never written to.",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Files",
            "type": "array"
          },
          "search_paths": {
            "description": "Extra directories to search for XREFs.",
            "items": {
              "type": "string"
            },
            "title": "Search Paths",
            "type": "array"
          }
        },
        "required": [
          "files"
        ],
        "title": "DrawingSetCreateRequest",
        "type": "object"
      },
      "DrawingSetCreateResponse": {
        "additionalProperties": false,
        "properties": {
          "drawing_set_id": {
            "title": "Drawing Set Id",
            "type": "string"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "drawing_set_id"
        ],
        "title": "DrawingSetCreateResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ImportStatus": {
        "description": "One file's progress through ``ingest/pipeline.py``.",
        "enum": [
          "PENDING",
          "COPYING",
          "CONVERTING",
          "BUILDING_WORKING_DXF",
          "CROSSCHECKING",
          "DONE",
          "FAILED",
          "NEEDS_MANUAL_CONVERSION"
