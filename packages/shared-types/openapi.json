  "info": {
    "title": "halo_engine",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/drawing-sets/{drawing_set_id}/files": {
      "get": {
        "operationId": "list_drawing_set_files_api_v1_drawing_sets__drawing_set_id__files_get",
        "parameters": [
          {
            "in": "path",
            "name": "drawing_set_id",
            "required": true,
            "schema": {
              "title": "Drawing Set Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DrawingFileSummary"
                  },
                  "title": "Response List Drawing Set Files Api V1 Drawing Sets  Drawing Set Id  Files Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Drawing Set Files",
        "tags": [
          "drawing-sets"
        ]
      }
    },
    "/api/v1/files/crosscheck": {
      "post": {
        "description": "Compare the two documents and return the report.",
        "operationId": "crosscheck_api_v1_files_crosscheck_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrosscheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CrosscheckReport"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Crosscheck",
        "tags": [
          "files"
        ]
      }
    },
