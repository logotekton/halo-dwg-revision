# Worker and wasm assets are copied at build time from @mlightcad/* by
# `pnpm --filter @halo-cad/web copy-viewer-assets`
# (packages/dwg-io-gpl/scripts/copy-worker-assets.mjs). They are ~11 MB of
# third-party build output, two of the three files are GPL-3.0, and their
# version is pinned by the lockfile — so they are produced, not committed
# (brief W3-02, "Defaults for ambiguity").
workers/
fonts/*.shx
fonts/*.woff
fonts/*.woff2
fonts/*.ttf
